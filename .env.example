# Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in server actions/route handlers
# for privileged admin tasks (e.g. creating the 3 family member auth users).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
